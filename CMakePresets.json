{
    "version": 6,
    "configurePresets": [
        {
            "name": "linux-release",
            "displayName": "Release (x86, Linux cross via xwin)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/linux-release",
            "toolchainFile": "${sourceDir}/cmake/xwin-linux.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "mac-release",
            "displayName": "Release (x86, macOS cross via xwin; docs/mac.md)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/mac-release",
            "toolchainFile": "${sourceDir}/cmake/xwin-mac.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "VULKAN_SDK_DIR": "$env{VULKAN_SDK}"
            }
        }
    ],
    "buildPresets": [
        { "name": "linux-release", "configurePreset": "linux-release" },
        { "name": "mac-release", "configurePreset": "mac-release" }
    ]
}
