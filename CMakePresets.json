{
    "version": 6,
    "configurePresets": [
        {
            "name": "linux-release",
            "displayName": "Release (x86, Linux cross via xwin)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/linux-release",
            "toolchainFile": "${sourceDir}/cmake/xwin-linux.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        }
    ],
    "buildPresets": [
        { "name": "linux-release", "configurePreset": "linux-release" }
    ]
}
